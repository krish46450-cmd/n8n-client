# Production Environment Configuration for Client App
# Copy this to .env and fill in the values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this
FLASK_ENV=production

# Database Configuration (Render will provide this automatically)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/client_app

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Support Dashboard Integration
# Update this with your deployed support dashboard URL
SUPPORT_API_URL=https://support-dashboard-xxxxx.onrender.com/api/tickets
SUPPORT_API_KEY=your-support-api-key-here

# Email Configuration (Optional - for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourdomain.com
